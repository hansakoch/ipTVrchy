        self.load_lbl.set_label(f"{I['tv']}  Loading {name}…")
        self.stack.set_visible_child_name("load")
        load_country(cc, lambda chs: self._on_country_loaded(chs, name))

    def _on_country_loaded(self, channels, name):
        if not channels:
            self.status_text.set_label(f"{I['error']}  No channels found for {name}")
            self.status_text.add_css_class("error")
            self._home()
            return False
        self.all_channels = channels; self._show_cats(channels, name)
        return False

    # ── Categories ───────────────────────────────────────────────────────

    def _show_cats(self, channels, country_name):
        self.state = "cats"; self._clear()
        self.flow.set_max_children_per_line(4); self.flow.set_min_children_per_line(2)
        self.stack.set_visible_child_name("grid"); self._update_hint("cats")

        cats = get_categories(channels)

        # Favorites first (if any)
        fav_chs = resolve_favorites(self.favorites, channels)
        if fav_chs:
            fav_btn = self._cat_btn(I["flag"], f"★ Favorites")
            fav_btn.connect("clicked", lambda b: self._show_channels(fav_chs, "★ Favorites"))
            self.flow.append(fav_btn); self.btns.append(fav_btn)

        btn = self._cat_btn(I["tv"], "All")
        btn.connect("clicked", lambda b: self._show_channels(channels, "All"))
        self.flow.append(btn); self.btns.append(btn)

        for cat_name, count in cats:
            icon = I.get(CAT_MAP.get(cat_name, "tv"), I["tv"])
            btn = self._cat_btn(icon, cat_name)
            btn.connect("clicked", lambda b, cn=cat_name: self._filter_cat(cn))
            self.flow.append(btn); self.btns.append(btn)

        self.lbl_count.set_label("")
        self.status_text.set_label(f"{len(channels)} channels")
        self.status_text.remove_css_class("error")
        if self.btns: GLib.idle_add(lambda: self.win.set_focus(self.btns[0]))

    def _cat_btn(self, icon, name):
        btn = Gtk.Button(); btn.add_css_class("cat-btn")
        btn.set_size_request(220, 64)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        box.set_valign(Gtk.Align.CENTER)
        ico = Gtk.Label(label=icon); ico.add_css_class("cat-icon"); box.append(ico)
        nm = Gtk.Label(label=name); nm.add_css_class("cat-name"); nm.set_xalign(0)
        box.append(nm)
        btn.set_child(box)
        return btn

    def _filter_cat(self, cat_name):
        filtered = [c for c in self.all_channels
                    if cat_name in [g.strip() for g in c["group"].split(";")]]
        country_name = self.nav[0][1] if self.nav else ""
        self.nav = [(self.current_cc, country_name), (cat_name, cat_name)]
        self._bc_update(); self._show_channels(filtered, cat_name)

    # ── Channels ─────────────────────────────────────────────────────────

    def _show_channels(self, channels, label=""):
        self.channels = channels; self.ch_idx = -1; self.state = "channels"
        self._clear()
        self.flow.set_max_children_per_line(8); self.flow.set_min_children_per_line(4)
        self._update_hint("channels")

        for i, ch in enumerate(channels):
            btn = Gtk.Button(); btn.add_css_class("ch-btn")
            btn.set_size_request(140, 140); btn.set_focusable(True); btn._idx = i
            img = Gtk.Image(); img.set_pixel_size(120); img.set_size_request(120, 120)
            lp = ch.get("logo_file")
            if lp and os.path.exists(lp):
                try: img.set_from_paintable(Gdk.Texture.new_from_filename(lp))
                except: img.set_from_icon_name("video-x-generic-symbolic")
            else: img.set_from_icon_name("video-x-generic-symbolic")
            btn.set_child(img)
            btn.connect("clicked", lambda b, i=i: self._play(i))
            self.flow.append(btn); self.btns.append(btn)

        self.lbl_count.set_label(f"{len(channels)}")
        self.status_text.set_label(f"{len(channels)} channels")
        self.status_text.remove_css_class("error")
        self.stack.set_visible_child_name("grid")
        if self.btns: GLib.idle_add(lambda: self.win.set_focus(self.btns[0]))
        self._load_logos(channels)

    def _load_logos(self, channels):
        def worker():
            for i, ch in enumerate(channels):
                url = ch.get("logo_url")
                if not url or ch.get("logo_file"): continue
                lp = download_logo(url)
                if lp: ch["logo_file"] = lp; GLib.idle_add(self._set_logo, i, lp)
        threading.Thread(target=worker, daemon=True).start()

    def _set_logo(self, idx, path):
        if idx < len(self.btns):
            img = self.btns[idx].get_child()
            if img and os.path.exists(path):
                try: img.set_from_paintable(Gdk.Texture.new_from_filename(path))
                except: pass
        return False

    def _clear(self):
        self.btns = []
        while self.flow.get_first_child(): self.flow.remove(self.flow.get_first_child())

    # ── Breadcrumb & Hints ───────────────────────────────────────────────

    def _bc_update(self):
        while self.bc_box.get_first_child(): self.bc_box.remove(self.bc_box.get_first_child())
        self.bc_box.set_visible(bool(self.nav))
        for i,(_, nm) in enumerate(self.nav):
            if i > 0:
                sep = Gtk.Label(label="›"); sep.add_css_class("header-bc"); self.bc_box.append(sep)
            lbl = Gtk.Label(label=nm); lbl.add_css_class("header-bc")
            if i == len(self.nav)-1: lbl.add_css_class("active")
            self.bc_box.append(lbl)

    def _update_hint(self, state):
        hints = {
            "home":     f'<kbd>{I["prev"]}{I["next"]}</kbd>  <kbd>Enter</kbd>  <kbd>Ctrl+F</kbd>',
            "cats":     f'<kbd>{I["prev"]}{I["next"]}</kbd>  <kbd>Enter</kbd>  <kbd>Esc</kbd>',
            "channels": f'<kbd>{I["prev"]}{I["next"]}</kbd>  <kbd>Enter</kbd>  <kbd>+/-</kbd> surf  <kbd>Esc</kbd>  <kbd>Ctrl+F</kbd>',
        }
        self.status_hint.set_markup(hints.get(state, ""))

    # ── Search ───────────────────────────────────────────────────────────

    def _toggle_search(self):
        vis = not self.search_bar.get_visible()
        self.search_bar.set_visible(vis)
        if vis: self.search_entry.grab_focus()
        else:
            self.search_entry.set_text("")
            if self.state == "search": self._back()

    def _on_search(self, entry):
        q = entry.get_text().strip()
        if len(q) < 2: return
        src = self.all_channels if self.all_channels else self.channels
        results = [c for c in src if q in c["name"].lower() or q in c.get("group","").lower()]
        self.state = "search"; self.channels = results; self.ch_idx = -1
        self._clear()
        self.flow.set_max_children_per_line(8); self.flow.set_min_children_per_line(4)
        self._update_hint("channels")
        for i, ch in enumerate(results):
            btn = Gtk.Button(); btn.add_css_class("ch-btn")
            btn.set_size_request(140, 140); btn.set_focusable(True); btn._idx = i
            img = Gtk.Image(); img.set_pixel_size(120); img.set_size_request(120, 120)
            # Use cached logo if available
            lp = ch.get("logo_file")
            if lp and os.path.exists(lp):
                try: img.set_from_paintable(Gdk.Texture.new_from_filename(lp))
                except: img.set_from_icon_name("video-x-generic-symbolic")
            else: img.set_from_icon_name("video-x-generic-symbolic")
            btn.set_child(img)
            btn.connect("clicked", lambda b, i=i: self._play(i))
            self.flow.append(btn); self.btns.append(btn)
        self.lbl_count.set_label(f"{len(results)}")
        self.stack.set_visible_child_name("grid")
        if self.btns: GLib.idle_add(lambda: self.win.set_focus(self.btns[0]))

    # ── Playback ─────────────────────────────────────────────────────────

    def _play(self, idx):
        if idx < 0 or idx >= len(self.channels): return
        ch = self.channels[idx]
        if 0 <= self.ch_idx < len(self.btns): self.btns[self.ch_idx].remove_css_class("playing")
        self.ch_idx = idx; self.state = "playing"
        if idx < len(self.btns): self.btns[idx].add_css_class("playing")
        self.status_text.set_label(f"{I['play']}  {ch['name']}")
        self.status_text.add_css_class("playing"); self.status_text.remove_css_class("error")
        self._show_osd(ch["name"], f"{idx+1} / {len(self.channels)}")
        self._mpv_play(ch["url"], ch.get("user_agent",""), ch["name"])
        self._mpv_watch()
        # Update hint for playing state
        self.status_hint.set_markup(f'<kbd>+/-</kbd> surf  <kbd>Esc</kbd> back  <kbd>Space</kbd> pause  <kbd>Ctrl+D</kbd> fav')

    def _show_osd(self, title, sub=""):
        self.osd_title.set_label(title); self.osd_sub.set_label(sub)
        self.osd_box.set_visible(True)
        if self._osd_id: GLib.source_remove(self._osd_id)
        self._osd_id = GLib.timeout_add(3000, self._hide_osd)

    def _hide_osd(self):
        self.osd_box.set_visible(False); self._osd_id = None; return False

    def _mpv_play(self, url, ua="", ch_name="IPTV"):
        if self._mpv_alive():
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(0.3); s.connect(MPV_SOCKET)
                s.send(json.dumps({"command":["loadfile",url,"replace"]}).encode()+b"\n")
                s.close(); self._mpv_t0 = time.time(); return
            except: pass
        self._mpv_stop()
        if os.path.exists(MPV_SOCKET):
            try: os.unlink(MPV_SOCKET)
            except: pass
        cmd = ["mpv","--no-terminal",
            "--hwdec=auto","--cache=yes","--cache-secs=30",
            "--vd-lavc-threads=2","--demuxer-max-bytes=50MiB",
            "--vo=gpu","--network-timeout=10",
            "--no-input-default-bindings","--fullscreen",
            f"--user-agent={ua or MPV_UA}",
            f"--input-ipc-server={MPV_SOCKET}",
            f"--input-conf={MPV_INPUT}",
            f"--title=ipTVrchy: {ch_name}",
            f"--force-media-title={ch_name}",
            url]
        try:
            self._mpv_log = open(MPV_LOG,"w")
            self._mpv = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=self._mpv_log)
            self._mpv_t0 = time.time()
        except Exception as e:
            self._mpv = None; self._err(f"mpv failed: {e}")

    def _mpv_alive(self): return self._mpv and self._mpv.poll() is None

    def _mpv_watch(self):
        if self._watch_id: GLib.source_remove(self._watch_id)
        self._watch_id = GLib.timeout_add(500, self._mpv_check)

    def _mpv_check(self):
        if not self._mpv_alive():
            elapsed = time.time() - self._mpv_t0
            if elapsed < 3:
                err = self._read_mpv_error()
                if self.state == "playing":
                    self._err(f"{I['error']}  {err}" if err else f"{I['error']}  Stream failed")
            if self.state == "playing": self._back_to_grid()
            return False
        return True

    def _read_mpv_error(self):
        try:
            if self._mpv_log: self._mpv_log.flush()
            if os.path.exists(MPV_LOG):
                with open(MPV_LOG) as f:
                    for ln in reversed(f.readlines()[-10:]):
                        l = ln.strip().lower()
                        if any(k in l for k in ["error","failed","403","forbidden","refused"]):
                            return ln.strip()[:100]
        except: pass
        return ""

    def _mpv_stop(self):
        if self._mpv_alive():
            self._mpv.terminate()
            try: self._mpv.wait(timeout=1)
            except:
                try: self._mpv.kill()
                except: pass
        self._mpv = None
        for f in [MPV_SOCKET]:
            if os.path.exists(f):
                try: os.unlink(f)
                except: pass
        if self._mpv_log:
            try: self._mpv_log.close()
            except: pass
            self._mpv_log = None

    def _err(self, msg):
        self.status_text.set_label(msg)
        self.status_text.add_css_class("error"); self.status_text.remove_css_class("playing")

    def _surf(self, delta):
        if not self.channels: return
        nxt = (self.ch_idx + delta) % len(self.channels)
        ch = self.channels[nxt]
        self._show_osd(ch["name"], f"{nxt+1} / {len(self.channels)}")
        self._play(nxt)

    # ── Keyboard ─────────────────────────────────────────────────────────

    def _on_key(self, ctrl, keyval, keycode, state):
        k = Gdk.keyval_name(keyval); s = self.state
        mod = state & Gdk.ModifierType.CONTROL_MASK

        # Ctrl+F — search (any state except playing)
        if k == "f" and mod and s != "playing":
            self._toggle_search(); return True

        # Ctrl+D — toggle favorite
        if k == "d" and mod and s == "playing" and 0 <= self.ch_idx < len(self.channels):
            ch = self.channels[self.ch_idx]
            self.favorites = toggle_favorite(self.favorites, ch)
            save_favorites(self.favorites)
            is_fav = is_favorite(self.favorites, ch)
            self._show_osd(f"{'★' if is_fav else '☆'} {ch['name']}", "Favorite" if is_fav else "Removed")
            return True

        # Escape
        if k == "Escape":
            if self.search_bar.get_visible():
                self.search_bar.set_visible(False); self.search_entry.set_text("")
                if s == "search": self._back()
                return True
            self._back(); return True

        # Channel surf from grid
        if k in ("plus","equal","KP_Add") and s in ("channels","search"):
            self._surf(1); return True
        if k in ("minus","underscore","KP_Subtract") and s in ("channels","search"):
            self._surf(-1); return True

        # Fullscreen toggle
        if k == "f" and not mod:
            if self.win.is_fullscreen(): self.win.unfullscreen()
            else: self.win.fullscreen()
            return True

        # Space — pause mpv
        if k == "space" and self._mpv_alive():
            try:
                sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                sock.settimeout(0.3); sock.connect(MPV_SOCKET)
                sock.send(json.dumps({"command":["cycle","pause"]}).encode()+b"\n"); sock.close()
            except: pass
            return True

        # F5 — refresh cache
        if k == "F5":
            for f in os.listdir(CACHE_DIR):
                if f.startswith("country_") and f.endswith(".m3u"):
                    try: os.remove(os.path.join(CACHE_DIR,f))
                    except: pass
            _cache.clear(); self._home(); return True

        # Enter
        if k in ("Return","KP_Enter"):
            foc = self.win.get_focus()
            if foc:
                if hasattr(foc, "_idx"): self._play(foc._idx)
                else: foc.emit("clicked")
            return True

        # Arrow navigation
        if s in ("home","cats","channels","search"):
            cols = 4 if s in ("home","cats") else 8
            if k == "Down":   self._nav(self.btns, cols);  return True
            if k == "Up":     self._nav(self.btns, -cols); return True
            if k == "Right":  self._nav(self.btns, 1);     return True
            if k == "Left":   self._nav(self.btns, -1);    return True

        return False

    def handle_ipc(self, action):
        if action == "next": self._surf(1)
        elif action == "prev": self._surf(-1)
        elif action == "quit": self._back()
        return False

    # ── Navigation ───────────────────────────────────────────────────────

    def _back(self):
        if self._watch_id: GLib.source_remove(self._watch_id); self._watch_id = None
        if self._osd_id: GLib.source_remove(self._osd_id); self._osd_id = None
        self.osd_box.set_visible(False)

        if self.state == "playing":
            self._mpv_stop(); self.state = "channels"
            self.status_text.set_label(""); self.status_text.remove_css_class("playing")
            self.status_text.remove_css_class("error"); self._update_hint("channels")
            if 0 <= self.ch_idx < len(self.btns): self.btns[self.ch_idx].grab_focus()
            return

        if self.state in ("channels","search"):
            self._mpv_stop()
            if self.all_channels:
                self.nav = [self.nav[0]] if self.nav else []; self._bc_update()
                self._show_cats(self.all_channels, self.nav[0][1] if self.nav else "")
            else: self._home()
            return

        if self.state == "cats": self._home(); return
        self._mpv_stop(); self._home()

    def _back_to_grid(self):
        if self._watch_id: GLib.source_remove(self._watch_id); self._watch_id = None
        self.state = "channels"; self.status_text.remove_css_class("playing")
        self._update_hint("channels")
        if 0 <= self.ch_idx < len(self.btns): self.btns[self.ch_idx].grab_focus()

    def _nav(self, widgets, delta):
        if not widgets: return
        foc = self.win.get_focus(); cur = -1; c = foc
        while c:
            if c in widgets: cur = widgets.index(c); break
            c = c.get_parent()
        nxt = max(0, min(len(widgets)-1, (cur+delta) if cur>=0 else 0))
        widgets[nxt].grab_focus()

    def _cleanup(self):
        self._mpv_stop()
        for f in [APP_SOCKET]:
            if os.path.exists(f):
                try: os.unlink(f)
                except: pass

    def do_shutdown(self):
        self._cleanup()
        Adw.Application.do_shutdown(self)

