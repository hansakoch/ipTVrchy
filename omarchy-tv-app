    def _cleanup_mpv(self):
        """Kill any orphaned mpv processes from previous runs."""
        try:
            r = subprocess.run(["pgrep", "-f", "mpv.*omarchy-tv"], capture_output=True, text=True)
            for pid in r.stdout.strip().split("\n"):
                if pid: subprocess.run(["kill", pid], capture_output=True)
        except: pass
        for f in [MPV_SOCKET, MPV_LOG]:
            if os.path.exists(f):
                try: os.unlink(f)
                except: pass

