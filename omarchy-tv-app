def _read_theme():
    try:
        link = os.path.expanduser("~/.config/omarchy/themes/current")
        target = os.readlink(link) if os.path.islink(link) else "/usr/share/omarchy/themes/matte-black"
        p = os.path.join(target, "colors.toml")
        if not os.path.exists(p): p = "/usr/share/omarchy/themes/matte-black/colors.toml"
        c = {}
        with open(p) as f:
            for line in f:
                m = re.match(r'(\w+)\s*=\s*"(#\w+)"', line.strip())
                if m: c[m.group(1)] = m.group(2)
        return c
    except: return {}

