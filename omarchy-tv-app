# ── Colors — pulled from Omarchy theme ───────────────────────────────────

def _read_theme():
    """Read current Omarchy theme colors."""
    try:
        # Find current theme
        home = os.path.expanduser("~")
        link = os.path.join(home, ".config/omarchy/themes/current")
        if os.path.islink(link):
            target = os.readlink(link)
        else:
            target = "/usr/share/omarchy/themes/catppuccin"
        colors_path = os.path.join(target, "colors.toml")
        if not os.path.exists(colors_path):
            colors_path = "/usr/share/omarchy/themes/catppuccin/colors.toml"
        colors = {}
        with open(colors_path) as f:
            for line in f:
                m = re.match(r'(\w+)\s*=\s*"(#\w+)"', line.strip())
                if m: colors[m.group(1)] = m.group(2)
        return colors
    except:
        return {}

_theme = _read_theme()

def C(name, fallback):
    return _theme.get(name, fallback)

# ── M3U Parser ───────────────────────────────────────────────────────────

def clean_name(n):
    n = re.sub(r'\s*\(\d+p\)\s*', ' ', n)
    n = re.sub(r'\s*\[?(?:Geo-blocked|Not 24\/7)\]?\s*', '', n, flags=re.I)
    n = re.sub(r'\s*\[\s*(?:SD|HD)\s*\]\s*', '', n, flags=re.I)
    return re.sub(r'\s+', ' ', n).strip()

def logo_hash(url):
    if not url: return None
    h = hashlib.md5(url.encode()).hexdigest()
    ext = os.path.splitext(urlparse(url).path)[1][:5] or ".png"
    return os.path.join(LOGO_DIR, f"{h}{ext}")

def parse_m3u(text):
    lines = text.split('\n')
    entries, i = [], 0
    while i < len(lines):
        line = lines[i].strip()
        if line.startswith("#EXTINF"):
            nm = re.search(r",([^,]+)$", line)
            gm = re.search(r'group-title="([^"]*)"', line)
            lm = re.search(r'tvg-logo="([^"]*)"', line)
            ua  = re.search(r'http-user-agent="([^"]*)"', line)
            logo_url = lm.group(1) if lm else ""
            cached = logo_hash(logo_url)
            i += 1
            while i < len(lines) and lines[i].strip().startswith("#"):
                v = re.search(r'http-user-agent=(.+)', lines[i].strip())
                if v and not ua:
                    ua = type('UA',(object,),{'group':lambda s,n:v.group(1)})()
                i += 1
            if i < len(lines):
                url = lines[i].strip()
                if url and not url.startswith("#"):
                    entries.append({
                        "name": clean_name(nm.group(1).strip() if nm else "?"),
                        "group": gm.group(1) if gm else "Undefined",
                        "logo_url": logo_url,
                        "logo_file": cached if cached and os.path.exists(cached) else None,
                        "user_agent": ua.group(1) if ua else "",
                        "url": url,
                    })
                i += 1
        else: i += 1
    seen, out = set(), []
    for c in entries:
        if c["url"] not in seen: seen.add(c["url"]); out.append(c)
    return out

# ── Network ──────────────────────────────────────────────────────────────

def http_get(url, timeout=15):
    try:
        r = subprocess.run(["curl","-4","-sL","--max-time",str(timeout),
                           "-H","User-Agent: OmarchyTV/1.0", url],
                          capture_output=True, timeout=timeout+2)
        return r.stdout.decode("utf-8", errors="ignore")
    except: return ""

def download_logo(url):
    if not url: return None
    p = logo_hash(url)
    if p and os.path.exists(p): return p
    try:
        subprocess.run(["curl","-4","-sL","--max-time","5",
                       "-H","User-Agent: OmarchyTV/1.0","-o",p,url],
                      capture_output=True, timeout=8)
        if os.path.exists(p) and os.path.getsize(p) > 100: return p
        if os.path.exists(p): os.unlink(p)
        return None
    except: return None

# ── Cache ────────────────────────────────────────────────────────────────

_cache = {}
_loading = set()

def cache_path(cc):
    return os.path.join(CACHE_DIR, f"country_{cc}.m3u")

def load_country(cc, cb):
    key = f"country_{cc}"
    if key in _cache: cb(_cache[key]); return
    if key in _loading: return
    _loading.add(key)
    def worker():
        cp = cache_path(cc)
        text = ""
        if os.path.exists(cp) and time.time()-os.path.getmtime(cp) < CACHE_AGE:
            with open(cp,"r",encoding="utf-8",errors="ignore") as f: text=f.read()
        if not text:
            text = http_get(f"{IPTV_BASE}/countries/{cc}.m3u")
            if text:
                try:
                    with open(cp,"w") as f: f.write(text)
                except: pass
            elif os.path.exists(cp):
                with open(cp,"r",encoding="utf-8",errors="ignore") as f: text=f.read()
        chs = parse_m3u(text) if text else []
        _cache[key] = chs
        _loading.discard(key)
        GLib.idle_add(cb, chs)
    threading.Thread(target=worker, daemon=True).start()

def get_categories(channels):
    counts = Counter()
    for ch in channels:
        for g in ch["group"].split(";"):
            g = g.strip()
            if g: counts[g] += 1
    return [(n, c) for n, c in counts.most_common() if c >= 2]

# ── IPC ──────────────────────────────────────────────────────────────────

_app_ref = None

def ipc_start():
    if os.path.exists(APP_SOCKET):
        try: os.unlink(APP_SOCKET)
        except: pass
    def listen():
        try:
            srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            srv.bind(APP_SOCKET); srv.listen(1); srv.settimeout(1.0)
            while True:
                try:
                    conn, _ = srv.accept()
                    data = conn.recv(1024).decode(); conn.close()
                    if data and _app_ref:
                        msg = json.loads(data.strip())
                        GLib.idle_add(_app_ref.handle_ipc, msg.get("action",""))
                except socket.timeout: continue
                except: pass
        except: pass
    threading.Thread(target=listen, daemon=True).start()

